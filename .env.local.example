# Cole aqui as credenciais do seu projeto Supabase
# Acesse: https://supabase.com/dashboard → seu projeto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
ANTHROPIC_API_KEY=sua-chave-anthropic-aqui
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Usada pelos crons (devocional, carta do mês e lembretes). Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Protege o cron diário de finanças: a Vercel envia "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=uma-frase-longa-e-aleatoria

# Lembretes no celular (Web Push). Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com
